# ============================================
# Registro de Faltas - variáveis de ambiente
# NUNCA coloque senhas reais neste arquivo (ele vai para o Git).
# ============================================

# ---- Servidor ----
NODE_ENV=production
PORT=3000
TZ=America/Maceio

# ---- Autenticação ----
# Gere um segredo com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
JWT_EXPIRES_IN=8h
# true exige HTTPS. Em HTTP puro na intranet use false.
COOKIE_SECURE=false

# ---- Banco local (SQLite) ----
DB_PATH=./data/sistema.db
BACKUP_RETENCAO=10

# ---- RM TOTVS (SQL Server, SOMENTE LEITURA) ----
RM_HOST=servidor-do-rm
RM_PORT=1433
RM_DATABASE=nome-do-banco-do-rm
RM_USER=usuario_somente_leitura
RM_PASSWORD=
RM_TIMEOUT_MS=15000
RM_ENCRYPT=false
RM_TRUST_CERT=true

# ---- Sincronização ----
SYNC_CRON="0 */2 * * *"
SYNC_COLIGADA=1
SYNC_ANO_INICIAL=2026